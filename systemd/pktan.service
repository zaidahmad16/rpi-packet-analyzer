[Unit]
Description=pktan network packet analyzer dashboard
After=network-online.target
Wants=network-online.target

[Service]
# Optional settings live in /etc/pktan.env (chmod 600), for example:
#   PKTAN_ARGS="-i wlan0 --sns-topic arn:aws:sns:ca-central-1:123456789012:pktan-alerts -w /var/lib/pktan/capture.pcap --max-mb 50 --s3-bucket my-pktan-captures"
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_REGION=ca-central-1
EnvironmentFile=-/etc/pktan.env
ExecStart=/usr/bin/python3 -m pktan web --port 8080 $PKTAN_ARGS
WorkingDirectory=/opt/pktan
Restart=on-failure
RestartSec=5
# Only the capabilities needed for raw capture; no full root powers.
DynamicUser=yes
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The one writable place: /var/lib/pktan, for --write captures waiting to go to S3.
StateDirectory=pktan
MemoryMax=200M
# Give the last S3 upload time to finish on stop.
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
