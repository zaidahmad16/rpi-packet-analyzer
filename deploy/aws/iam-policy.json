{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:REGION:ACCOUNT_ID:pktan-alerts"
    },
    {
      "Sid": "UploadCaptures",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BUCKET_NAME/pktan/*"
    }
  ]
}
